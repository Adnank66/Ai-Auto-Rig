# PC Builder Environment Configuration

# Server port
PORT=3001

# Node environment
NODE_ENV=development

# Enable mock pricing (returns sample Amazon/Flipkart offers without real API keys)
PRICE_MOCK=1

# Cache TTL for price results (milliseconds) - 10 minutes
PRICE_CACHE_TTL_MS=600000

# Admin token for component CRUD operations
# Default for local development
ADMIN_TOKEN=dev-admin

# Database file path (optional, defaults to data/pcbuilder.db relative to project root)
# DB_FILE=./data/pcbuilder.db

# Amazon Product Advertising API (optional - leave blank for mock mode)
#AMAZON_ACCESS_KEY=
#AMAZON_SECRET_KEY=
#AMAZON_PARTNER_TAG=
#AMAZON_MARKETPLACE=www.amazon.in

# Flipkart Affiliate API (optional - leave blank for mock mode)
#FLIPKART_AFFILIATE_ID=
#FLIPKART_AFFILIATE_TOKEN=

# Image search providers (optional)
#GOOGLE_CSE_KEY=
#GOOGLE_CSE_CX=
#PEXELS_API_KEY=
#IMAGE_CACHE_TTL_MS=86400000
